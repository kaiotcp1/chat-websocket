{
  "name": "realtime-rooms",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "build:lambda": "esbuild src/lambdas/connection.ts src/lambdas/realtime.ts --bundle --platform=node --target=node22 --outdir=dist/lambdas --external:@aws-sdk/*",
    "build:all": "npm run build:lambda && npm run build",
    "smoke:websocket": "node scripts/smoke-websocket.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.750.0",
    "@aws-sdk/client-dynamodb": "^3.750.0",
    "@aws-sdk/lib-dynamodb": "^3.750.0",
    "next": "^15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.13.14",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "esbuild": "^0.25.1",
    "eslint": "^9.22.0",
    "eslint-config-next": "^15.2.4",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9",
    "ws": "^8.18.1"
  }
}
